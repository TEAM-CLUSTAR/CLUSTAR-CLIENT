{
  "extends": "@clustar/typescript-config/react.json",
  "compilerOptions": {
    "baseUrl": ".",
    "plugins": [{ "name": "react" }],
    "types": ["vitest/globals", "vite/client"],
    "paths": {
      "@apis/*": ["src/apis/*"],
      "@app/*": ["src/app/*"],
      "@constants/*": ["src/constants/*"],
      "@pages/*": ["src/pages/*"],
      "@router/*": ["src/router/*"],
      "@shared/*": ["src/shared/*"]
    }
  },
  "include": ["src", "vite.config.ts"],
  "exclude": ["node_modules"]
}
